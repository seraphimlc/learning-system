    "do_not_repeat_if": "孩子能稳定选择基准、判断量级并用估算检查精算。"
  },
  "child_card": {
    "title": "数感与估算",
    "one_sentence": "先判断答案大概在哪，再计算；这样结果离谱时你能马上发现。",
    "default_sequence": [
      "sense-essence",
      "sense-range",
      "sense-benchmark",
      "sense-plausible",
      "sense-meter"
    ]
  },
  "internal_card": {
    "teaching_goal": "建立估算作为错误检测工具的意识，为小数、科学记数法、单位换算和有理数运算提供量级证据。",
    "runtime_priority": "foundation_gateway",
    "planner_hint": "数感稳定后可以显著减少底层计算题数量；若不稳，优先做范围和基准选择，不急着精算。"
  }
