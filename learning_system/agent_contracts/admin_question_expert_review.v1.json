{
  "agent_key": "admin_question_expert_review_agent",
  "contract_key": "admin_question_expert_review",
  "contract_version": "2026-07-23.admin-question-expert-review.v1",
  "prompt_version_id": "2026-07-23.admin-question-expert-review.prompt.v1",
  "prompt_template_path": "learning_system/prompts/admin_question_expert_review.v1.md",
  "response_schema_version": "2026-07-23.admin-question-expert-review.schema.v1",
  "response_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "overall_status",
      "confidence",
      "profile_reviews",
      "findings",
      "activation_implication",
      "next_actions"
    ],
    "properties": {
      "schema_version": {
        "const": "2026-07-23.admin-question-expert-review.schema.v1"
      },
      "overall_status": {
        "type": "string",
        "enum": [
          "pass",
          "pass_with_scope",
          "needs_revision",
          "reject"
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "profile_reviews": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "status",
            "reasons",
            "blocking_item_ids",
            "repair_suggestions"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "enum": [
                "frontline_math_teacher",
                "bridge_diagnosis_teacher",
                "stretch_competition_teacher",
                "assessment_expert",
                "source_compliance_reviewer"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "pass_with_scope",
                "needs_revision",
                "reject"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocking_item_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "repair_suggestions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "severity",
            "profile",
            "item_id",
            "code",
            "message"
          ],
          "properties": {
            "severity": {
              "type": "string",
              "enum": [
                "P0",
                "P1",
                "P2",
                "INFO"
              ]
            },
            "profile": {
              "type": "string"
            },
            "item_id": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "activation_implication": {
        "const": "does_not_authorize_activation"
      },
      "next_actions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "minimum_confidence_to_apply": 0.86,
  "engine_type": "model_assisted_quality_gate",
  "authority": "review_receipt_only",
  "does_not_authorize_activation": true,
  "profiles": [
    "frontline_math_teacher",
    "bridge_diagnosis_teacher",
    "stretch_competition_teacher",
    "assessment_expert",
    "source_compliance_reviewer"
  ],
  "output_must_not": [
    "activate_question",
    "write_mastery",
    "choose_next_child_step",
    "copy_external_commercial_content"
  ]
}
