{
  "agent_key": "admin_question_qa_review_agent",
  "contract_key": "admin_question_qa_review",
  "contract_version": "2026-07-24.admin-question-qa-review.v1",
  "prompt_version_id": "2026-07-24.admin-question-qa-review.prompt.v1",
  "prompt_template_path": "learning_system/prompts/admin_question_qa_review.v1.md",
  "response_schema_version": "2026-07-24.admin-question-qa-review.schema.v1",
  "response_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "overall_status",
      "confidence",
      "profile_reviews",
      "hard_blockers",
      "scope",
      "findings",
      "activation_implication",
      "next_actions"
    ],
    "properties": {
      "schema_version": {
        "const": "2026-07-24.admin-question-qa-review.schema.v1"
      },
      "overall_status": {
        "type": "string",
        "enum": [
          "pass",
          "pass_with_scope",
          "needs_revision",
          "reject"
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "profile_reviews": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "status",
            "reasons",
            "repair_suggestions"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "enum": [
                "mathematical_validity",
                "answer_contract_alignment",
                "graph_family_alignment",
                "child_appropriateness",
                "diagnostic_meaningfulness"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "pass_with_scope",
                "needs_revision",
                "reject"
              ]
            },
            "reasons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "repair_suggestions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "hard_blockers": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mathematical_ambiguity",
          "prompt_answer_conflict",
          "node_or_family_mismatch",
          "age_inappropriate",
          "meaningless_formal_requirement"
        ],
        "properties": {
          "mathematical_ambiguity": {
            "$ref": "#/$defs/blocker_evidence"
          },
          "prompt_answer_conflict": {
            "$ref": "#/$defs/blocker_evidence"
          },
          "node_or_family_mismatch": {
            "$ref": "#/$defs/blocker_evidence"
          },
          "age_inappropriate": {
            "$ref": "#/$defs/blocker_evidence"
          },
          "meaningless_formal_requirement": {
            "$ref": "#/$defs/blocker_evidence"
          }
        }
      },
      "scope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "support_only",
          "not_for_activation",
          "exclude_from_coverage",
          "reasons"
        ],
        "properties": {
          "support_only": {
            "type": "boolean"
          },
          "not_for_activation": {
            "type": "boolean"
          },
          "exclude_from_coverage": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "severity",
            "profile",
            "item_id",
            "issue_type",
            "code",
            "message"
          ],
          "properties": {
            "severity": {
              "type": "string",
              "enum": [
                "P0",
                "P1",
                "P2",
                "INFO"
              ]
            },
            "profile": {
              "type": "string",
              "enum": [
                "mathematical_validity",
                "answer_contract_alignment",
                "graph_family_alignment",
                "child_appropriateness",
                "diagnostic_meaningfulness"
              ]
            },
            "item_id": {
              "type": "string"
            },
            "issue_type": {
              "type": "string",
              "enum": [
                "mathematical_ambiguity",
                "prompt_answer_conflict",
                "node_or_family_mismatch",
                "age_inappropriate",
                "meaningless_formal_requirement",
                "other_semantic_issue"
              ]
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "activation_implication": {
        "const": "does_not_authorize_activation"
      },
      "next_actions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "$defs": {
      "blocker_evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detected",
          "evidence"
        ],
        "properties": {
          "detected": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "minimum_confidence_to_apply": 0.86,
  "engine_type": "live_model_semantic_quality_gate",
  "authority": "review_receipt_only",
  "does_not_authorize_activation": true,
  "final_status_authority": "deterministic_profile_normalizer",
  "profiles": [
    "mathematical_validity",
    "answer_contract_alignment",
    "graph_family_alignment",
    "child_appropriateness",
    "diagnostic_meaningfulness"
  ],
  "output_must_not": [
    "activate_question",
    "write_mastery",
    "choose_next_child_step",
    "copy_external_commercial_content"
  ]
}
