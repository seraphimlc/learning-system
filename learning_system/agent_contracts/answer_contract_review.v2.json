{
  "agent_key": "answer_contract_reviewer_agent",
  "contract_key": "answer_contract_review",
  "contract_version": "2026-07-14.answer-contract-review.v2",
  "prompt_version_id": "2026-07-14.answer-contract-review.prompt.v2",
  "prompt_template_path": "learning_system/prompts/answer_contract_review.v2.md",
  "response_schema_version": "2026-07-14.answer-contract-review.schema.v2",
  "minimum_confidence_to_apply": 0.8,
  "engine_type": "model",
  "authority": "independent_structured_issue_review_only",
  "provider_trust_modes": ["live_model", "recorded_model", "not_configured"],
  "non_authority": [
    "does_not_edit_question_or_reference_answer",
    "does_not_rebind_node",
    "does_not_edit_or_activate_contract",
    "does_not_assign_authoritative_repair_actions",
    "does_not_generate_lineage_or_digest_fields"
  ],
  "response_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "items"],
    "properties": {
      "schema_version": {
        "const": "2026-07-14.answer-contract-review.schema.v2"
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item_handle",
            "question_correctness",
            "reference_answer_correctness",
            "node_alignment",
            "evidence_role_alignment",
            "contract_verdict",
            "issues",
            "confidence"
          ],
          "properties": {
            "item_handle": {"type": "string", "minLength": 1, "maxLength": 120},
            "question_correctness": {"type": "string", "enum": ["pass", "fail", "unclear"]},
            "reference_answer_correctness": {"type": "string", "enum": ["pass", "fail", "unclear"]},
            "node_alignment": {"type": "string", "enum": ["aligned", "misbound", "unclear"]},
            "evidence_role_alignment": {"type": "string", "enum": ["aligned", "misaligned", "unclear"]},
            "contract_verdict": {"type": "string", "enum": ["approved", "rejected"]},
            "issues": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "slot_key", "detail", "repairable"],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "question_incorrect",
                      "reference_answer_incorrect",
                      "question_node_misaligned",
                      "evidence_role_misaligned",
                      "criterion_bundled",
                      "criterion_overlap",
                      "criterion_unobservable",
                      "reference_evidence_broad",
                      "reference_evidence_missing",
                      "derived_grounding_invalid",
                      "presentation_only_scored",
                      "prompt_demand_missing",
                      "slot_not_allowed",
                      "score_weight_invalid",
                      "mastery_dimension_invalid",
                      "required_for_pass_invalid",
                      "low_confidence",
                      "other_contract_issue"
                    ]
                  },
                  "slot_key": {"type": ["string", "null"]},
                  "detail": {"type": "string", "minLength": 1, "maxLength": 1200},
                  "repairable": {"type": "boolean"}
                }
              }
            },
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
