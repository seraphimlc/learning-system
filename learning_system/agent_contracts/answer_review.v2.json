{
  "agent_key": "answer_analysis_agent",
  "contract_key": "answer_review",
  "contract_version": "2026-07-11.answer-review.v5-skeleton.v2",
  "prompt_version_id": "2026-07-11.answer-review.v5.prompt.v2",
  "prompt_template_path": "learning_system/prompts/answer_review.v2.md",
  "response_schema_version": "2026-07-11.answer-review.v5.schema.v2",
  "minimum_confidence_to_apply": 0.68,
  "engine_type": "model",
  "authority": "semantic_evidence_only",
  "provider_trust_modes": ["live_model", "recorded_model", "mock_only", "not_configured"],
  "non_authority": [
    "does_not_update_mastery_state",
    "does_not_choose_next_step",
    "does_not_generate_teaching_step",
    "does_not_treat_score_as_mastery"
  ],
  "response_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "result",
      "score_points",
      "max_points",
      "confidence",
      "answer_analysis",
      "evaluation_support",
      "next_evidence_need"
    ],
    "properties": {
      "schema_version": {"const": "2026-07-11.answer-review.v5.schema.v2"},
      "result": {"type": "string", "enum": ["correct", "partial", "wrong", "unclear"]},
      "score_points": {"type": "number", "minimum": 0, "maximum": 2},
      "max_points": {"type": "number", "const": 2},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "error_tags": {
        "type": "array",
        "items": {"type": "string"},
        "maxItems": 6
      },
      "blocking_evidence": {"type": "boolean"},
      "answer_analysis": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "optimal_answer",
          "optimal_solution_steps",
          "child_answer_summary",
          "comparison",
          "process_gap",
          "teaching_explanation",
          "next_child_prompt"
        ],
        "properties": {
          "optimal_answer": {"type": "string"},
          "optimal_solution_steps": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 8},
          "child_answer_summary": {"type": "string"},
          "comparison": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimension", "status", "detail"],
              "properties": {
                "dimension": {
                  "type": "string",
                  "enum": ["final_answer", "model_or_relation", "steps", "symbols_units", "check_or_explanation", "other"]
                },
                "status": {
                  "type": "string",
                  "enum": ["matched", "missing", "incorrect", "unclear", "alternative_valid"]
                },
                "detail": {"type": "string"}
              }
            },
            "minItems": 5,
            "maxItems": 8
          },
          "alternative_solutions": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
          "process_gap": {"type": "string"},
          "teaching_explanation": {"type": "string"},
          "next_child_prompt": {"type": "string"}
        }
      },
      "evaluation_support": {
        "type": "object",
        "additionalProperties": false,
        "required": ["usable_for_evaluation", "evidence_strength", "reasoning_soundness"],
        "properties": {
          "usable_for_evaluation": {"type": "boolean"},
          "evidence_strength": {"type": "string", "enum": ["strong", "medium", "weak", "insufficient"]},
          "reasoning_soundness": {"type": "string", "enum": ["sound", "incomplete", "unsound", "unclear"]},
          "dominant_gap_dimensions": {"type": "array", "items": {"type": "string"}, "maxItems": 6}
        }
      },
      "next_evidence_need": {
        "type": "string",
        "enum": ["none", "same_structure_confirmation", "near_transfer_confirmation", "prerequisite_probe", "clearer_solution_evidence", "targeted_reteach"]
      }
    }
  }
}
