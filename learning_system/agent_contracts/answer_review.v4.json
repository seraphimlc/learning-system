{
  "agent_key": "answer_analysis_agent",
  "contract_key": "answer_review",
  "contract_version": "2026-08-25.answer-review.lite.v4",
  "prompt_version_id": "2026-08-25.answer-review.lite.prompt.v1",
  "prompt_template_path": "learning_system/prompts/answer_review.v4.md",
  "response_schema_version": "2026-08-25.answer-review.lite.schema.v1",
  "minimum_confidence_to_apply": 0.68,
  "engine_type": "model",
  "authority": "lite_score_and_error_tags",
  "provider_trust_modes": [
    "live_model",
    "recorded_model",
    "mock_only",
    "not_configured"
  ],
  "non_authority": [
    "does_not_update_mastery_state",
    "does_not_choose_next_action",
    "does_not_generate_assessment_authority"
  ],
  "response_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "score",
      "result",
      "error_tags",
      "improvement",
      "confidence"
    ],
    "properties": {
      "schema_version": {
        "const": "2026-08-25.answer-review.lite.schema.v1"
      },
      "score": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      },
      "result": {
        "type": "string",
        "enum": [
          "correct",
          "partial",
          "wrong"
        ]
      },
      "error_tags": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "string",
          "enum": [
            "concept_confusion",
            "modeling_or_reading",
            "calculation_or_symbol",
            "process_habit",
            "visual_spatial",
            "general"
          ]
        }
      },
      "improvement": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  }
}