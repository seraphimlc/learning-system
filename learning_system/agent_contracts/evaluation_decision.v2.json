{
  "agent_key": "evaluation_agent",
  "contract_key": "evaluation_decision",
  "contract_version": "2026-07-11.evaluation-decision.v5-skeleton.v2",
  "prompt_version_id": "2026-07-11.evaluation-decision.v5.prompt.v2",
  "prompt_template_path": "learning_system/prompts/evaluation_decision.v2.md",
  "response_schema_version": "2026-07-11.evaluation-decision.v5.schema.v2",
  "minimum_confidence_to_apply": 0.8,
  "engine_type": "model",
  "authority": "advisory_mastery_recommendation",
  "provider_trust_modes": ["live_model", "recorded_model", "mock_only", "not_configured"],
  "non_authority": [
    "does_not_grade_raw_answer",
    "does_not_mutate_mastery_state",
    "does_not_select_question",
    "does_not_generate_child_teaching"
  ],
  "response_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "node_id",
      "source_evidence_validation_ids",
      "source_answer_analysis_agent_run_ids",
      "mastery_recommendation",
      "dimension_scores",
      "planner_signal",
      "confidence",
      "reason"
    ],
    "properties": {
      "schema_version": {"const": "2026-07-11.evaluation-decision.v5.schema.v2"},
      "node_id": {"type": "string"},
      "source_evidence_validation_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
      "source_answer_analysis_agent_run_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
      "mastery_recommendation": {
        "type": "string",
        "enum": ["no_update", "blocked", "weak", "emerging", "likely_stable", "stable_for_now"]
      },
      "dimension_scores": {
        "type": "object",
        "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "planner_signal": {
        "type": "object",
        "additionalProperties": false,
        "required": ["next_evidence_goal", "needs_teaching_before_next", "needs_prerequisite_probe"],
        "properties": {
          "next_evidence_goal": {
            "type": "string",
            "enum": ["same_structure_retest", "near_transfer_retest", "prerequisite_probe", "clarify_evidence", "summary", "blocked"]
          },
          "needs_teaching_before_next": {"type": "boolean"},
          "needs_prerequisite_probe": {"type": "boolean"},
          "target_gap_dimensions": {"type": "array", "items": {"type": "string"}, "maxItems": 6}
        }
      },
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "reason": {"type": "string"}
    }
  }
}
