{
  "agent_key": "question_designer_agent",
  "contract_key": "math_question_bank_v12_designer_batch",
  "contract_version": "2026-07-12.math-qb-v12.designer-batch.v4",
  "prompt_version_id": "2026-07-12.math-qb-v12.designer.prompt.v4",
  "prompt_template_path": "learning_system/prompts/math_question_bank_v12_designer_batch.v4.md",
  "response_schema_version": "2026-07-12.math-qb-v12.designer.schema.v4",
  "minimum_confidence_to_apply": 0.82,
  "engine_type": "model",
  "authority": "candidate_generation_only",
  "provider_trust_modes": ["live_model", "recorded_model", "mock_only", "not_configured"],
  "non_authority": [
    "does_not_approve_active_use",
    "does_not_mutate_sqlite",
    "does_not_select_child_next_step",
    "does_not_import_external_private_question_bank"
  ],
  "response_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "node_id", "graph_version", "question_bank_version", "items", "batch_confidence", "design_notes"],
    "properties": {
      "schema_version": {"const": "2026-07-12.math-qb-v12.designer.schema.v4"},
      "node_id": {"type": "string"},
      "graph_version": {"type": "string"},
      "question_bank_version": {"const": "2026-07-12.bank.v12"},
      "batch_confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "design_notes": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
      "items": {
        "type": "array",
        "minItems": 20,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "slot",
            "slot_role",
            "node_id",
            "kind",
            "question_type",
            "variant_level",
            "prompt",
            "interaction_schema",
            "answer_format",
            "expected_answer",
            "accepted_alternatives",
            "solution_steps",
            "target_error_tags",
            "rollback_candidates",
            "problem_family_id",
            "core_stem_id",
            "math_core_signature",
            "evidence_goal",
            "elicitation_mode",
            "child_surface_design",
            "intended_instruction_voice_family",
            "difficulty_vector",
            "requires_reasoning",
            "node_local_mainline",
            "controlled_stretch",
            "estimated_minutes",
            "designer_artifact"
          ],
          "properties": {
            "id": {"type": "string"},
            "slot": {"type": "integer", "minimum": 1, "maximum": 20},
            "slot_role": {"type": "string"},
            "node_id": {"type": "string"},
            "kind": {"type": "string"},
            "question_type": {"type": "string"},
            "variant_level": {"type": "string", "enum": ["L1", "L2", "L3", "L4"]},
            "prompt": {"type": "string"},
            "interaction_schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "type",
                "title",
                "allow_explanation",
                "explanation_label",
                "fields",
                "choices",
                "formula_label",
                "placeholder"
              ],
              "properties": {
                "schema_version": {"const": "2026-07-13.question-interaction.v1"},
                "type": {
                  "type": "string",
                  "enum": ["short_text", "fill_blank", "single_choice", "multi_choice", "formula_input"]
                },
                "title": {"type": "string"},
                "allow_explanation": {"type": "boolean"},
                "explanation_label": {"type": "string"},
                "fields": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "label", "placeholder", "prefix", "suffix"],
                    "properties": {
                      "id": {"type": "string"},
                      "label": {"type": "string"},
                      "placeholder": {"type": "string"},
                      "prefix": {"type": "string"},
                      "suffix": {"type": "string"}
                    }
                  }
                },
                "choices": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "label"],
                    "properties": {
                      "id": {"type": "string"},
                      "label": {"type": "string"}
                    }
                  }
                },
                "formula_label": {"type": "string"},
                "placeholder": {"type": "string"}
              }
            },
            "answer_format": {"type": "string"},
            "expected_answer": {"type": "string"},
            "accepted_alternatives": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
            "solution_steps": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 8},
            "target_error_tags": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 4},
            "rollback_candidates": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
            "problem_family_id": {"type": "string"},
            "core_stem_id": {"type": "string"},
            "math_core_signature": {"type": "string"},
            "evidence_goal": {"type": "string"},
            "elicitation_mode": {"type": "string"},
            "child_surface_design": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prompt_mode", "notation_mode", "response_burden"],
              "properties": {
                "prompt_mode": {"const": "natural_self_contained_mathematical_task"},
                "notation_mode": {"const": "child_surface_plain_math"},
                "response_burden": {"const": "single_coherent_current_step"}
              }
            },
            "intended_instruction_voice_family": {
              "type": "string",
              "enum": [
                "solve_and_interpret",
                "compare_and_choose",
                "diagnose_and_repair",
                "represent_and_translate",
                "classify_and_justify",
                "estimate_and_predict",
                "construct_or_complete",
                "reverse_reasoning",
                "validate_a_claim",
                "explain_a_relationship"
              ]
            },
            "difficulty_vector": {
              "type": "object",
              "additionalProperties": false,
              "required": ["concept_demand", "reasoning_steps", "calculation_load", "representation_demand", "transfer_distance"],
              "properties": {
                "concept_demand": {"type": "integer", "minimum": 1, "maximum": 4},
                "reasoning_steps": {"type": "integer", "minimum": 1, "maximum": 8},
                "calculation_load": {"type": "integer", "minimum": 1, "maximum": 4},
                "representation_demand": {"type": "integer", "minimum": 1, "maximum": 4},
                "transfer_distance": {"type": "integer", "minimum": 0, "maximum": 4}
              }
            },
            "requires_reasoning": {"const": true},
            "node_local_mainline": {"type": "boolean"},
            "controlled_stretch": {"type": "boolean"},
            "estimated_minutes": {"type": "integer", "minimum": 3, "maximum": 10},
            "designer_artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": ["designer_run_id", "prompt_version_id", "design_rationale"],
              "properties": {
                "designer_run_id": {"type": "string"},
                "prompt_version_id": {"const": "2026-07-12.math-qb-v12.designer.prompt.v4"},
                "design_rationale": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
