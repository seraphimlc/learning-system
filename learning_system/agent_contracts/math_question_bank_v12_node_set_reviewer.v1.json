{
  "agent_key": "question_reviewer_agent",
  "contract_key": "math_question_bank_v12_node_set_review",
  "contract_version": "2026-07-12.math-qb-v12.node-set-reviewer.v1",
  "prompt_version_id": "2026-07-12.math-qb-v12.node-set-reviewer.prompt.v1",
  "prompt_template_path": "learning_system/prompts/math_question_bank_v12_node_set_reviewer.v1.md",
  "response_schema_version": "2026-07-12.math-qb-v12.node-set-review.schema.v1",
  "minimum_confidence_to_apply": 0.88,
  "engine_type": "model",
  "authority": "full_node_set_semantic_quality_review_only",
  "provider_trust_modes": ["live_model", "recorded_model", "mock_only", "not_configured"],
  "non_authority": [
    "does_not_generate_replacement_question",
    "does_not_mutate_sqlite",
    "does_not_activate_question",
    "does_not_self-certify_manifest"
  ],
  "response_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "node_id",
      "graph_version",
      "question_bank_version",
      "verdict",
      "rejected_slots",
      "duplicate_groups",
      "distribution_scores",
      "confidence",
      "reasons",
      "repair_instructions"
    ],
    "properties": {
      "schema_version": {"const": "2026-07-12.math-qb-v12.node-set-review.schema.v1"},
      "node_id": {"type": "string"},
      "graph_version": {"type": "string"},
      "question_bank_version": {"const": "2026-07-12.bank.v12"},
      "verdict": {"type": "string", "enum": ["approved", "needs_repair", "blocked"]},
      "rejected_slots": {
        "type": "array",
        "items": {"type": "integer", "minimum": 1, "maximum": 20},
        "maxItems": 20
      },
      "duplicate_groups": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slots", "reason"],
          "properties": {
            "slots": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1, "maximum": 20},
              "minItems": 2,
              "maxItems": 20
            },
            "reason": {"type": "string"}
          }
        }
      },
      "distribution_scores": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_diversity",
          "slot_fit",
          "difficulty_distribution",
          "problem_family_distribution",
          "age_context_fit"
        ],
        "properties": {
          "semantic_diversity": {"type": "number", "minimum": 0, "maximum": 1},
          "slot_fit": {"type": "number", "minimum": 0, "maximum": 1},
          "difficulty_distribution": {"type": "number", "minimum": 0, "maximum": 1},
          "problem_family_distribution": {"type": "number", "minimum": 0, "maximum": 1},
          "age_context_fit": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "reasons": {
        "type": "array",
        "items": {"type": "string"},
        "minItems": 1,
        "maxItems": 12
      },
      "repair_instructions": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slot", "reason", "guidance"],
          "properties": {
            "slot": {"type": "integer", "minimum": 1, "maximum": 20},
            "reason": {"type": "string"},
            "guidance": {"type": "string"}
          }
        }
      }
    }
  }
}
