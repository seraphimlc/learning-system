{
  "agent_key": "question_reviewer_agent",
  "contract_key": "math_question_bank_v12_reviewer_batch",
  "contract_version": "2026-07-12.math-qb-v12.reviewer-batch.v4",
  "prompt_version_id": "2026-07-12.math-qb-v12.reviewer.prompt.v4",
  "prompt_template_path": "learning_system/prompts/math_question_bank_v12_reviewer_batch.v4.md",
  "response_schema_version": "2026-07-12.math-qb-v12.reviewer.schema.v4",
  "minimum_confidence_to_apply": 0.88,
  "engine_type": "model",
  "authority": "authoritative_item_semantic_review_verdict",
  "provider_trust_modes": ["live_model", "recorded_model", "mock_only", "not_configured"],
  "non_authority": [
    "does_not_generate_replacement_question",
    "does_not_mutate_sqlite",
    "does_not_activate_question",
    "does_not_self_certify_manifest"
  ],
  "response_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "node_id", "graph_version", "question_bank_version", "item_reviews", "batch_verdict", "batch_reason"],
    "properties": {
      "schema_version": {"const": "2026-07-12.math-qb-v12.reviewer.schema.v4"},
      "node_id": {"type": "string"},
      "graph_version": {"type": "string"},
      "question_bank_version": {"const": "2026-07-12.bank.v12"},
      "batch_verdict": {"type": "string", "enum": ["approved", "needs_repair", "blocked"]},
      "batch_reason": {"type": "string"},
      "item_reviews": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["item_id", "candidate_sha256", "verdict", "scores", "reasons", "repair_instructions", "reviewer_evidence", "semantic_evidence", "confidence"],
          "properties": {
            "item_id": {"type": "string"},
            "candidate_sha256": {"type": "string"},
            "verdict": {"type": "string", "enum": ["approved", "rejected", "needs_repair"]},
            "scores": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node_alignment", "mathematical_correctness", "reasoning_signal", "non_mechanical", "answer_alignment"],
              "properties": {
                "node_alignment": {"type": "number", "minimum": 0, "maximum": 1},
                "mathematical_correctness": {"type": "number", "minimum": 0, "maximum": 1},
                "reasoning_signal": {"type": "number", "minimum": 0, "maximum": 1},
                "non_mechanical": {"type": "number", "minimum": 0, "maximum": 1},
                "answer_alignment": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 8},
            "repair_instructions": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
            "reviewer_evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "agent_key",
                "provenance_type",
                "graph_bound",
                "incoming_grade_7_ready",
                "diagnostic_structure",
                "process_evidence_required",
                "not_mechanical_drill",
                "child_prompt_self_contained",
                "specific_expected_answer",
                "review_rationale"
              ],
              "properties": {
                "agent_key": {"const": "question_reviewer_agent"},
                "provenance_type": {"const": "v12_independent_semantic_review"},
                "graph_bound": {"type": "boolean"},
                "incoming_grade_7_ready": {"type": "boolean"},
                "diagnostic_structure": {"type": "boolean"},
                "process_evidence_required": {"type": "boolean"},
                "not_mechanical_drill": {"type": "boolean"},
                "child_prompt_self_contained": {"type": "boolean"},
                "specific_expected_answer": {"type": "boolean"},
                "review_rationale": {"type": "string"}
              }
            },
            "semantic_evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "ux_verdict",
                "natural_self_contained_task",
                "natural_chinese",
                "rendered_notation_readiness",
                "age_dignity",
                "instruction_voice_family",
                "response_moves",
                "unprompted_process_evidence",
                "process_target_disclosed",
                "process_disclosure_evidence",
                "evidence",
                "repair_direction"
              ],
              "properties": {
                "version": {"const": "2026-07-12.math-qb-v12.item-review-semantic-evidence.v4"},
                "ux_verdict": {"type": "string", "enum": ["approved", "needs_repair", "rejected"]},
                "natural_self_contained_task": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["verdict", "score", "reason"],
                  "properties": {
                    "verdict": {"type": "string", "enum": ["pass", "fail"]},
                    "score": {"type": "number", "minimum": 0, "maximum": 1},
                    "reason": {"type": "string"}
                  }
                },
                "natural_chinese": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["verdict", "score", "reason"],
                  "properties": {
                    "verdict": {"type": "string", "enum": ["pass", "fail"]},
                    "score": {"type": "number", "minimum": 0, "maximum": 1},
                    "reason": {"type": "string"}
                  }
                },
                "rendered_notation_readiness": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["verdict", "score", "reason", "child_visible_risks"],
                  "properties": {
                    "verdict": {"type": "string", "enum": ["pass", "fail"]},
                    "score": {"type": "number", "minimum": 0, "maximum": 1},
                    "reason": {"type": "string"},
                    "child_visible_risks": {"type": "array", "items": {"type": "string"}, "maxItems": 8}
                  }
                },
                "age_dignity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["verdict", "score", "reason"],
                  "properties": {
                    "verdict": {"type": "string", "enum": ["pass", "fail"]},
                    "score": {"type": "number", "minimum": 0, "maximum": 1},
                    "reason": {"type": "string"}
                  }
                },
                "instruction_voice_family": {
                  "type": "string",
                  "enum": [
                    "solve_and_interpret",
                    "compare_and_choose",
                    "diagnose_and_repair",
                    "represent_and_translate",
                    "classify_and_justify",
                    "estimate_and_predict",
                    "construct_or_complete",
                    "reverse_reasoning",
                    "validate_a_claim",
                    "explain_a_relationship"
                  ]
                },
                "response_moves": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 8},
                "unprompted_process_evidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["applicability", "verdict", "score", "reason"],
                  "properties": {
                    "applicability": {"type": "string", "enum": ["required", "not_applicable"]},
                    "verdict": {"type": "string", "enum": ["satisfied", "violated", "not_applicable"]},
                    "score": {"type": "number", "minimum": 0, "maximum": 1},
                    "reason": {"type": "string"}
                  }
                },
                "process_target_disclosed": {"type": "boolean"},
                "process_disclosure_evidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["verdict", "source_field", "quote", "reason"],
                  "properties": {
                    "verdict": {"type": "string", "enum": ["disclosed", "not_disclosed"]},
                    "source_field": {"type": "string", "enum": ["none", "child_visible.prompt"]},
                    "quote": {"type": "string"},
                    "reason": {"type": "string"}
                  }
                },
                "evidence": {"type": "string", "minLength": 1},
                "repair_direction": {"type": "string", "minLength": 1}
              }
            },
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
