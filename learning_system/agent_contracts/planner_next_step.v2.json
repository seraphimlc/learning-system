        "type": "string",
        "enum": [
          "same_structure_retest",
          "near_transfer_retest",
          "prerequisite_probe",
          "micro_teach",
          "worked_example",
          "clarify_evidence",
          "continue_new_knowledge",
          "stretch",
          "summary",
          "blocked"
