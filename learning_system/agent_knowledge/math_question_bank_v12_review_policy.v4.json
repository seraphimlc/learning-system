    "move_definition": "one independently requested child action visible in the prompt"
  },
  "semantic_clusters": {
    "duplicate_definition": "substantially the same givens, unknown relation, transformation path, error mechanism, or answer path",
    "repetitive_instruction_cluster_definition": "substantially the same child-facing action and sentence skeleton despite cosmetic wording changes",
