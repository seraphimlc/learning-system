{
  "schema_version": "2026-07-11.v5.10-lesson-harness-contract.v2",
  "harness_script": "scripts/live_child_v5_10_lessons.py",
  "legacy_harness": {
    "script": "scripts/live_child_ui_10x.py",
    "classification": "legacy_fixed_group_only",
    "eligible_for_v5_pass": false
  },
  "route_family": [
    "/api/child-bootstrap",
    "/api/daily-flow/review/start",
    "/api/current-step/submit",
    "/api/current-step/continue",
    "/api/daily-flow/new-knowledge/start",
    "/api/daily-flow/finish"
  ],
  "forbidden_legacy_dependencies": [
    "generated_plans",
    "learning_sessions",
    "learning_group",
    "today_plan",
    "/api/child-submissions",
    "planner.LEARNING_ROUND_TASK_COUNT",
    "fixed_task_count"
  ],
  "execution_contract": {
    "lesson_count": 10,
    "independent_temp_db_per_lesson": true,
    "independent_upload_root_per_lesson": true,
    "browser_entry_state": "start_resume",
    "adaptive_current_step_only": true,
    "pre_read_fixed_question_list": false,
    "interaction_budget": {
      "minimum": 10,
      "maximum": 20,
      "unit": "child_action_advancing_or_committing_the_current_visible_step",
      "counted_actions": [
        "start_resume",
        "submit_text",
        "submit_photo",
        "submit_text_photo",
        "submit_stuck",
        "continue_teaching",
        "still_stuck_after_teaching",
        "submit_clarification",
        "continue_assessment_feedback",
        "retry_blocked_origin_stage",
        "start_new_knowledge",
        "finish_to_summary"
      ]
    },
    "condition_waiting": {
      "strategy": "poll_observed_browser_and_durable_state",
      "forbidden_workflow_waits": [
        "time.sleep",
        "fixed_delay_before_next_interaction"
      ],
      "required_conclusions": [
        "current_step",
        "analyzing_pending",
        "assessment_feedback",
        "feedback_teaching",
        "clarify_evidence",
        "ready_for_new_knowledge",
        "blocked",
        "summary"
      ]
    }
  },
  "model_contract": {
    "default_mode": "recorded_model",
    "live_flag": "--live-model",
    "recorded_fixture_required": true,
    "patched_outputs_may_be_labeled_live": false,
    "allowed_non_live_modes": [
      "recorded_model"
    ],
    "live_providers": [
      "gpt",
      "doubao"
    ],
    "live_semantic_pass_requires": [
      "--live-model",
      "unpatched_external_model_calls",
      "provider_mode=live_model",
      "schema_valid_agent_outputs",
      "oracle_comparison"
    ]
  },
  "live_fault_injection_contract": {
    "lesson_id": "L09-model-recovery",
    "enabled_only_in_mode": "live_model",
    "inject_after_durable_attempt_and_job_save": true,
    "workflow_evidence_only": true,
    "excluded_from_live_semantic_verdict": true,
    "other_live_lessons_external_model_calls_unpatched": true,
    "stages": [
      {
        "ordinal": 1,
        "answer_class": "model_missing",
        "fault_type": "not_configured",
        "expected_job_status": "blocked"
      },
      {
        "ordinal": 2,
        "answer_class": "model_failing",
        "fault_type": "controlled_retryable_failure",
        "expected_job_status": "retry"
      }
    ],
    "recovery_requires": {
      "answer_analysis_provider_mode": "live_model",
      "accepted_real_provider_agent_run_per_faulted_attempt": true,
      "forbidden_semantic_recovery_providers": [
        "recorded_model",
        "mock_only",
        "deterministic_runtime"
      ]
    }
  },
  "photo_fixture_contract": {
    "readable_photo": "clear expected answer plus a real solution step and check",
    "text_photo_conflict": "clear photo answer differs from typed expected answer",
    "unclear_photo": "meaningful expected-answer source image blurred after rendering",
    "ocr_hallucination": "same meaningful expected-answer source image blurred after rendering",
    "required_trace_fields": [
      "source_text",
      "source_content_sha256",
      "source_image_sha256",
      "rendered_image_sha256",
      "file_sha256",
      "byte_size"
    ]
  },
  "required_browser_actions": [
    "click",
    "text_input",
    "photo_upload",
    "stuck",
    "wait_for_analyzing_conclusion",
    "continue_teaching",
    "submit_clarification",
    "finish_summary"
